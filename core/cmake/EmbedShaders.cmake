# 把 shaders/ 下的源码嵌进一个 C++ 文件（原始字符串字面量），运行时按文件名查找。
# shader 文件一改，CMAKE_CONFIGURE_DEPENDS 会触发重新配置，生成文件随之更新。
function(cinegl_embed_shaders OUT_FILE)
    set(entries "")
    foreach(path ${ARGN})
        get_filename_component(name "${path}" NAME)
        file(READ "${path}" content)
        string(APPEND entries "    {\"${name}\", R\"CINEGL_SHADER(${content})CINEGL_SHADER\"},\n")
    endforeach()
    set(source "// 自动生成，请勿手改：源文件在 core/shaders/\n")
    string(APPEND source "#include <string>\n\n#include \"pipeline/ShaderLibrary.h\"\n\n")
    string(APPEND source "namespace cinegl::shaders {\n\nnamespace {\n")
    string(APPEND source "struct Entry {\n    const char* name;\n    const char* source;\n};\n\n")
    string(APPEND source "const Entry kEntries[] = {\n${entries}};\n}  // namespace\n\n")
    string(APPEND source "const char* findEmbedded(const std::string& name) {\n")
    string(APPEND source "    for (const Entry& e : kEntries) {\n        if (name == e.name) return e.source;\n    }\n")
    string(APPEND source "    return nullptr;\n}\n\n}  // namespace cinegl::shaders\n")
    file(WRITE "${OUT_FILE}.tmp" "${source}")
    configure_file("${OUT_FILE}.tmp" "${OUT_FILE}" COPYONLY)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${ARGN})
endfunction()
